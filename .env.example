# Development defaults
NETMASK_ENV=development
NETMASK_HOST=127.0.0.1
NETMASK_PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-long-random-value
ENABLE_GUEST_ACCESS=true
ENABLE_DEBUG_ROUTES=true
# Required only for a remote authorized-lab notification test. Use a long random value.
NETMASK_LAB_ALERT_TOKEN=replace-with-a-long-random-lab-token

# Capture
CAPTURE_ENABLED=true
CAPTURE_INTERFACE=
CAPTURE_FILTER=ip and (tcp or udp)
FLOW_TIMEOUT_SECONDS=120
INCIDENT_WINDOW_SECONDS=120

# Browser origins (comma-separated, exact values)
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
